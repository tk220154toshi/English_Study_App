{
  "name": "engc-english-code-editor",
  "version": "0.1.0",
  "description": "EngC — a VSCode-style English learning editor that compiles your English and throws grammar 'errors' generated by an LLM.",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "ios:add": "cap add ios",
    "ios": "cap sync ios && cap open ios"
  },
  "engines": {
    "node": ">=18.17"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "@capacitor/core": "^6.2.1",
    "@capacitor/ios": "^6.2.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "license": "MIT",
  "devDependencies": {
    "@capacitor/cli": "^6.2.1"
  }
}
