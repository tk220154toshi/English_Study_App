# Copy this file to `.env` and fill in your Anthropic API key.
# Get a key at https://console.anthropic.com/

ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: override the model. Defaults to claude-opus-4-8.
# For lower cost / higher throughput you can use claude-sonnet-5 or claude-haiku-4-5.
# ENGC_MODEL=claude-opus-4-8

# Optional: port (defaults to 5173)
# PORT=5173
